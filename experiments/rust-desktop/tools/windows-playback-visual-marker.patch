+#[cfg(all(target_os = "windows", feature = "benchmark"))]
+fn update_visual_playback_proof(
+    previous: &mut Option<(u32, u32, u32)>,
+    position: Option<u32>,
+) -> bool {
+    let Some(position) = position else {
+        *previous = None;
+        return false;
+    };
+    let (first, last, samples) = previous.get_or_insert((position, position, 1));
+    if (1..=2_500).contains(&position.saturating_sub(*last)) {
+        *samples += 1;
+    } else {
+        *first = position;
+        *samples = 1;
+    }
+    *last = position;
+    *samples >= 3 && position - *first >= 2_000
+}
