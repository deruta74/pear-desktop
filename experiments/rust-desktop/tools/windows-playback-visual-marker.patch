+fn record_windows_visual_checkpoint(name: &str) {
+    if std::env::var_os("PEAR_WINDOWS_VISUAL_DIAGNOSTIC").is_none_or(|value| value != "1") {
+        return;
+    }
+    if let Some(dir) = std::env::var_os("PEAR_PREVIEW_QUEUE_DIR").map(PathBuf::from)
+        && dir.is_absolute()
+    {
+        // These files duplicate fixed diagnostic events without relying on stdout.
+        let _ = fs::write(dir.join("visual-checkpoints").join(name), []);
+    }
+}
